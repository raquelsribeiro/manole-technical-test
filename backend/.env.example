# ===== SERVER CONFIGURATION =====
PORT=3333
NODE_ENV=development

# ===== DATABASE CONFIGURATION =====
# Database type (better-sqlite3 for SQLite)
DATABASE_TYPE=better-sqlite3

# Database file path (use /data/tasks.sqlite in Docker)
DATABASE_PATH=./data/tasks.sqlite

# Auto-synchronize database schema on startup
# ⚠️  CRITICAL: Set to false in PRODUCTION to prevent schema changes
DATABASE_SYNCHRONIZE=true

# Enable SQL logging for debugging
DATABASE_LOGGING=false

# ===== CORS CONFIGURATION =====
# Allow requests from specific origins
# Development: * (all origins)
# Production: https://app.example.com,https://www.example.com
CORS_ORIGIN=*

# ===== API CONFIGURATION =====
# Default pagination limit for API responses
DEFAULT_PAGE_LIMIT=10

# Log level (debug, info, warn, error)
API_LOG_LEVEL=debug

# ===== TIMEZONE =====
API_TIMEZONE=UTC
